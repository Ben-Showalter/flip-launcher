<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules. See backup_rules.xml: the launcher's
  preferences are excluded from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="flip_launcher_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="flip_launcher_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
