<?xml version="1.0" encoding="utf-8"?>
<!-- Gallery wallpaper crop screen: the photo (movable/zoomable), Home's
     dimming scrim, Home itself (clock, soft keys, D-pad pod) drawn on top,
     and a key hint in the status-bar band. See WallpaperCropActivity. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/crop_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.flipos.launcher.ui.CropView
        android:id="@+id/crop_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/crop_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/crop_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <TextView
        android:id="@+id/crop_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E6000000"
        android:ellipsize="end"
        android:focusable="false"
        android:gravity="center"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="3dp"
        android:text="@string/crop_hint"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/crop_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC000000"
        android:focusable="false"
        android:padding="10dp"
        android:text="@string/crop_loading"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</FrameLayout>
