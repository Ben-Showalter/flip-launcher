<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/row_margin_horizontal"
    android:layout_marginVertical="@dimen/row_margin_vertical"
    android:background="@drawable/bg_item_focus"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/row_padding_horizontal"
        android:paddingEnd="@dimen/row_padding_horizontal"
        android:paddingTop="@dimen/row_padding_vertical"
        android:paddingBottom="@dimen/row_padding_vertical">

        <FrameLayout
            android:id="@+id/row_icon_wrap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/row_padding_horizontal">

            <ImageView
                android:id="@+id/row_icon"
                android:layout_width="@dimen/list_icon"
                android:layout_height="@dimen/list_icon"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <View
                android:id="@+id/row_notif_dot"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge_dot"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:duplicateParentState="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/row_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_on_item"
                android:textSize="@dimen/text_row_title" />

            <TextView
                android:id="@+id/row_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_secondary_on_item"
                android:textSize="@dimen/text_row_subtitle"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_trailing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:duplicateParentState="true"
            android:textColor="@color/text_secondary_on_item"
            android:textSize="@dimen/text_row_trailing"
            android:visibility="gone" />

        <TextView
            android:id="@+id/row_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:duplicateParentState="true"
            android:minWidth="34dp"
            android:gravity="center"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textSize="@dimen/text_row_trailing"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/row_chevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="@dimen/space_xs"
            android:duplicateParentState="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron"
            android:visibility="gone" />
    </LinearLayout>

</FrameLayout>
